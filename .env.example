# ============================================================
# UniLake backend — environment variables
# ============================================================
# Copy to `.env` and fill in. Every variable below is REQUIRED:
# src/config/env.ts refuses to start the server if any is missing.
# Never commit real values to this file.

# ---- Server ----
# Port the HTTP + WebSocket server listens on. The frontend's default
# NEXT_PUBLIC_AUTH_URL assumes 8080.
PORT=8080
# "development" enables pretty logs, debug-level logging and real error
# messages in 500 responses. Production MUST be "production" — secure
# cross-subdomain auth cookies depend on it.
NODE_ENV=development

# ---- Database (PostgreSQL — Neon in production) ----
# Pooled connection string, used by the app at runtime.
DATABASE_URL=
# Direct (non-pooled) connection string, used by the Prisma CLI for migrations.
DIRECT_URL=

# ---- Redis (BullMQ job queues) ----
# e.g. redis://localhost:6379 locally, rediss://… for a managed instance.
REDIS_URL=

# ---- Auth (Better Auth) ----
# Long random string, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Public origin of THIS backend, e.g. http://localhost:8080.
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ---- Frontend ----
# Public origin of the Next.js site, used to build links in customer emails.
# No trailing slash. Local: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---- Cloudflare R2 (S3-compatible object storage) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# S3 API endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Private bucket: customer photos, LoRA files, fonts.
R2_PRIVATE_BUCKET_NAME=
# Public bucket: artwork, generated pages, thumbnails, PDFs.
R2_PUBLIC_BUCKET_NAME=
# Public URL that serves the public bucket, e.g. https://pub-xxxx.r2.dev
R2_PUBLIC_URL_BASE=

# ---- RunPod (ComfyUI face-swap generation) ----
RUNPOD_ENDPOINT_ID=
RUNPOD_API_KEY=

# ---- Razorpay (payments) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured on the Razorpay webhook; verifies the HMAC signature.
RAZORPAY_WEBHOOK_SECRET=

# ---- Shiprocket (shipping) ----
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
# Must exactly match a pickup location name in the Shiprocket dashboard.
SHIPROCKET_PICKUP_LOCATION_NAME=
# Token Shiprocket sends in the x-api-key header of its webhooks.
SHIPROCKET_WEBHOOK_TOKEN=

# ---- Email (Resend) ----
RESEND_API_KEY=
# Sender address — the domain must be verified in Resend.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=UniLake Kids
