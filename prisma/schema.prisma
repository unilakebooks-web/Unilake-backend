// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String         @id
  name           String
  email          String
  emailVerified  Boolean        @default(false)
  image          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sessions       Session[]
  accounts       Account[]
  orderSessions  OrderSession[]
  savedAddresses SavedAddress[]
  role           String         @default("USER")

  // Coupons reserved for this one customer, and every coupon this customer used.
  restrictedCoupons Coupon[]
  couponRedemptions CouponRedemption[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ============================================================
// COMIC CATALOGUE
// ============================================================

enum AgeGroup {
  AGE_0_2
  AGE_3_5
  AGE_6_8
  AGE_9_12
}

enum CoverType {
  HARDCOVER
  SOFTCOVER
}

enum GenderTag {
  BOY
  GIRL
  UNISEX
}

enum ComicStatus {
  DRAFT
  PUBLISHING // publish job in progress (async sync to ComfyUI)
  PUBLISHED
  UNPUBLISHED
}

model Theme {
  id   String @id @default(uuid())
  name String @unique

  comics Comic[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("themes")
}

model Comic {
  id                 String      @id @default(uuid())
  title              String
  genderTags         GenderTag[] @default([])
  pageCount          Int
  freePreviewPages   Int
  coverThumbnailUrls String[]    @default([])
  previewVideoUrl    String?
  loraFileUrl        String?
  loraStrength       Float       @default(1.0)
  status             ComicStatus @default(DRAFT)
  publishJobId       String?
  publishError       String?

  pages         Page[]
  fonts         Font[]
  pricingRules  PricingRule[]
  orderSessions OrderSession[]
  facts         ComicFact[]
  couponComics  CouponComic[]

  metaTitle       String?
  metaDescription String?

  isBestseller Boolean @default(false)

  // Website order, ascending: the order customers see (home, Our Books, Explore
  // more). Only PUBLISHED comics' relative order matters. Renumbered by the
  // admin's reorder; a new comic takes the top (smallest number minus one).
  sortOrder Int @default(0)

  // Automatic data deletion (feature 6). unpublishedAt: when a published comic stopped being
  // published (the delete button waits 30 days from it); null is never eligible.
  // retiredAt: an admin retired the comic (its sessions and orders keep it, nothing new can use it).
  // filesDeletedAt: the retire's file deletion finished (set only by the deletion engine).
  unpublishedAt  DateTime?
  retiredAt      DateTime?
  filesDeletedAt DateTime?

  description String?    @db.Text
  themes      Theme[]
  ageGroups   AgeGroup[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("comics")
}

model Page {
  id      String @id @default(uuid())
  comicId String
  comic   Comic  @relation(fields: [comicId], references: [id], onDelete: Cascade)

  pageNumber Int // 1–24
  artworkUrl String? // HD PNG, empty bubbles, R2 public URL
  maskUrl    String? // PNG marking head area, R2 public URL

  // Real pixel size of artworkUrl, probed server-side with Sharp at upload time.
  // Null until artwork is attached. Used to (a) reject a mask whose size doesn't
  // match, (b) warn when a replaced artwork changes aspect ratio, (c) show the
  // size in the admin UI. NOT needed to position bubbles - those are normalized.
  artworkWidth  Int?
  artworkHeight Int?

  // Original file names as the admin's browser reported them when the file was
  // uploaded. Display only: never used in a key, a path or a URL. Null for files
  // uploaded before these columns existed (the name was never sent then).
  artworkFileName String?
  maskFileName    String?

  hasFace       Boolean @default(false) // does the child's face appear on this page
  mirrorFace    Boolean @default(false) // should the face be flipped
  faceDirection String? // "front" | "three-quarter" | "side"
  isPreviewPage Boolean @default(false) // part of free preview (pages 1–10 typically)
  pagePrompt    String? @db.Text

  steps Int   @default(3)
  cfg   Float @default(1.0)

  bubbles      Bubble[]
  pageVersion  PageVersion[]
  sessionPages SessionPage[]
  createdAt    DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([comicId, pageNumber])
  @@map("pages")
}

enum TextAlign {
  LEFT
  CENTER
  RIGHT
}

enum TextVerticalAlign {
  TOP
  MIDDLE
  BOTTOM
}

enum TextCase {
  AS_TYPED
  UPPERCASE
  LOWERCASE
}

model Bubble {
  id     String @id @default(uuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  // Normalized 0–1 fractions of the artwork's dimensions - NOT pixels.
  // x/y is the top-left corner. Constraints (enforced in Zod + bubble.service):
  //   0 <= x, y            x + width <= 1        y + height <= 1
  // Resolution-independent by design: artwork can be re-uploaded at any size
  // without invalidating existing bubbles.
  x      Float
  y      Float
  width  Float
  height Float

  dialogue  String  @db.Text // contains tokens: {name}, {pronoun_subject}, {pronoun_object}, {pronoun_possessive}
  fontId    String?
  font      Font?   @relation(fields: [fontId], references: [id])
  // Normalized fraction of the artwork's HEIGHT, not pixels.
  // Rendered size = fontSize * artworkHeight.
  // Default 0.02 ≈ 31px on a 1536px-tall page.
  fontSize  Float   @default(0.02)
  fontColor String  @default("#000000")
  nameColor String?

  textAlign         TextAlign         @default(CENTER)
  textVerticalAlign TextVerticalAlign @default(MIDDLE)
  textCase          TextCase          @default(AS_TYPED)

  sortOrder Int @default(0) // order bubbles were added, for predictable rendering/debugging

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bubbles")
}

model Font {
  id      String @id @default(uuid())
  comicId String
  comic   Comic  @relation(fields: [comicId], references: [id], onDelete: Cascade)

  name    String // display name, e.g. "ComicSans-Bold"
  fileUrl String // R2 path to .ttf/.otf
  bubbles Bubble[]

  createdAt DateTime @default(now())

  @@map("fonts")
}

// ============================================================
// PRICING (country-based)
// ============================================================

model PricingRule {
  id      String @id @default(uuid())
  comicId String
  comic   Comic  @relation(fields: [comicId], references: [id], onDelete: Cascade)

  countryId String
  country   Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  coverType CoverType
  mrp       Decimal?  @db.Decimal(10, 2)
  price     Decimal   @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([comicId, countryId, coverType])
  @@map("pricing_rules")
}

// ============================================================
// COMIC-ORDER FLOW
// Named "OrderSession" (not "Session") specifically to avoid colliding
// with Better Auth's own Session model in this same schema file.
// This has nothing to do with login - it's the in-progress
// comic-creation flow for an anonymous parent/user.
// ============================================================

enum OrderSessionStatus {
  CREATED
  PHOTO_UPLOADED
  GENERATING_PREVIEW
  PREVIEW_READY
  AWAITING_PAYMENT
  PAID
  GENERATING_PAID
  PAID_PAGES_READY
  CONFIRMED
  COMPILING_PDF
  PDF_FAILED
  SHIPMENT_QUEUED
  SHIPMENT_FAILED
  COMPLETED
  FAILED
}

enum PronounKey {
  HE
  SHE
  THEY
}

model OrderSession {
  id      String @id @default(uuid())
  comicId String
  comic   Comic  @relation(fields: [comicId], references: [id])

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  childName         String?
  pronounKey        PronounKey?
  notificationEmail String?
  coverType         CoverType?
  age               Int?
  status            OrderSessionStatus @default(CREATED)

  // Photo validation
  rawPhotoUrls   String[] // up to 2 uploaded photos, R2 paths
  bestPhotoUrl   String? // winner from validation pipeline
  photoScoreJson Json? // breakdown of the check scores

  // Shipping (collected before payment)
  shippingName    String?
  shippingLine1   String?
  shippingLine2   String?
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingCountry String? // ISO alpha-2 - drives domestic vs international Shiprocket routing
  shippingPhone   String?

  wsRoomToken String @unique @default(uuid()) // used to authenticate WS connection

  // An admin's sample book: a real session that an admin made to try a book without paying. It
  // never gets an Order, its files and rows are deleted soon after it expires, and the customer
  // routes that lead to payment refuse it. Set once when the sample is created, never changed.
  isSample Boolean @default(false)

  // Automatic data deletion (feature 6): set when the deletion of the private photo / of the
  // preview and page files STARTS (the claim), never cleared except by an admin release.
  photoDeletedAt DateTime?
  filesDeletedAt DateTime?

  pageVersions PageVersion[]
  sessionPages SessionPage[]
  order        Order?
  share        SessionShare?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime // 24hr TTL equivalent, enforced at query time / cleanup job

  @@index([isSample, expiresAt])
  @@index([filesDeletedAt, expiresAt])
  @@map("order_sessions")
}

// The view-only link to a session's book (feature 14). One row per session: the random token in the link is
// NOT the session id, so sharing it never gives anyone the customer's private link. Revoking keeps the row;
// sharing again gives the row a new token. The share dies with the session: it is checked on every read.
model SessionShare {
  id             String       @id @default(uuid())
  orderSessionId String       @unique
  orderSession   OrderSession @relation(fields: [orderSessionId], references: [id], onDelete: Cascade)

  token     String    @unique // 24 random bytes, base64url (32 characters)
  showName  Boolean   @default(false) // the child's first name in the page title and link preview
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@map("session_shares")
}

// The pages a session's book is made of, frozen when the session is created.
// Pages the admin adds to the comic later belong only to sessions created after
// them. `isPreviewPage` is frozen too, so flipping a page between free and paid
// never changes a book already in progress. Page CONTENT (artwork, bubbles,
// prompt) is deliberately not frozen - edits reach every session.
//
// Deleting a Page removes it from these rows (cascade). deletePage already
// refuses once any session has generated the page, so only books that never
// rendered it lose it.
model SessionPage {
  orderSessionId String
  orderSession   OrderSession @relation(fields: [orderSessionId], references: [id], onDelete: Cascade)
  pageId         String
  page           Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)

  isPreviewPage Boolean

  createdAt DateTime @default(now())

  @@id([orderSessionId, pageId])
  @@index([pageId])
  @@map("session_pages")
}

// ============================================================
// GENERATED PAGE VERSIONS (AI pipeline output)
// ============================================================

enum PageVersionStatus {
  QUEUED
  TEXT_STAMPING
  TEXT_STAMPED
  GENERATING_SD
  SD_READY
  FAILED
}

model PageVersion {
  id             String       @id @default(uuid())
  orderSessionId String
  orderSession   OrderSession @relation(fields: [orderSessionId], references: [id], onDelete: Cascade)

  // pageNumber   Int
  pageId String
  page   Page   @relation(fields: [pageId], references: [id])

  variantIndex Int     @default(0) // 0,1,2... up to 3-4 free / 8 paid
  seed         BigInt? // ComfyUI seed used, stored for reproducibility

  textStampedUrl  String? // Sharp output - artwork with text stamped, INPUT to ComfyUI
  comfyJobId      String? // RunPod job ID for the face-swap job
  displayImageUrl String? // for storing the display URL that ougth to be displayed in the browser
  finalImageUrl   String? // ComfyUI output - face-swapped + text-stamped, shown to user & used in PDF

  isSelected   Boolean           @default(false) // chosen by user at confirm step
  status       PageVersionStatus @default(QUEUED)
  errorMessage String?
  retryCount   Int               @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderSessionId, pageId, variantIndex])
  @@index([orderSessionId, pageId])
  @@map("page_versions")
}

// ============================================================
// ORDERS / PAYMENTS
// ============================================================

enum OrderStatus {
  CREATED // Order row created, Razorpay order created, awaiting payment
  PAID // Payment succeeded, paid-page generation in progress
  GENERATED // All paid pages ready, waiting for user to select variants + send-to-print
  CONFIRMED // User clicked send-to-print, PDF compiled, Shiprocket queued
  SHIPROCKET_FAILED // Shiprocket order creation exhausted retries, admin handles manually
  READY_TO_SHIP // Shiprocket order created, admin fills dims + generates AWB
  SHIPPED // AWB generated, package handed to courier
  DELIVERED // Shiprocket webhook confirmed delivery
  CANCELLED // Manual admin cancellation (edge case)
}

model Order {
  id             String       @id @default(uuid())
  orderSessionId String       @unique
  orderSession   OrderSession @relation(fields: [orderSessionId], references: [id])

  // What the customer actually pays. With a coupon this is the discounted
  // amount, so the Razorpay order, Shiprocket, revenue stats and customer
  // totals all keep reading one correct number.
  amount      Decimal   @db.Decimal(10, 2)
  currency    String
  countryCode String // snapshot of country used for pricing lookup at order time
  coverType   CoverType

  // Coupon snapshot, written once when the order is created. listAmount is the
  // price before the discount (null on orders placed before coupons existed).
  listAmount     Decimal? @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  couponCode     String?

  notificationEmail String?

  // Shipping address - copied from OrderSession at order creation. Changed only by an admin address edit, which keeps every old value in OrderAddressChange.
  shippingName    String?
  shippingLine1   String?
  shippingLine2   String?
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingCountry String? // ISO alpha-2
  shippingPhone   String?

  razorpayOrderId   String?     @unique
  razorpayPaymentId String?     @unique
  status            OrderStatus @default(CREATED)

  // Earlier Razorpay orders for this same Order, kept when the customer changes
  // or removes a coupon after starting checkout (a new Razorpay order replaces
  // razorpayOrderId). A payment that arrives on one of these is flagged to ops
  // instead of vanishing as an unknown order.
  supersededRazorpayOrderIds String[] @default([])

  pdfUrl            String? // R2 path, 30-day retention
  pdfDownloadUrl    String? // signed URL, 7-day validity
  pdfDownloadExpiry DateTime?

  shiprocketOrderId    String?
  awbNumber            String?
  courierName          String?
  trackingStatus       String?
  trackingUpdatedAt    DateTime?
  shiprocketShipmentId String?
  courierId            Int?
  isInternational      Boolean   @default(false)
  trackingUrl          String?

  // Real package dimensions (admin-entered at packaging)
  finalLength  Float?
  finalBreadth Float?
  finalHeight  Float?
  finalWeight  Float?

  // Lifecycle timestamps
  awbGeneratedAt      DateTime?
  labelGeneratedAt    DateTime?
  pickupScheduledDate DateTime?
  pickupGeneratedAt   DateTime?
  shippedAt           DateTime?
  deliveredAt         DateTime?

  printVendorOrderId String? // e.g. Gelato order reference

  // Bill of Supply. Assigned once, in the payment-captured transaction, to
  // INR orders only, and never changed - "BOS-26-00001" is serial 1 of FY
  // 2026-27. billIssuedAt is the payment time, printed as the Date of Issue.
  // The PDF itself is never stored; it is rebuilt from these on download.
  billNumber   String?   @unique
  billIssuedAt DateTime?

  // The book title as it was when the bill was issued, so renaming a book later
  // does not change a bill already given out. Written with the bill number, in
  // the same transaction. Null on a bill issued before this column existed and
  // not backfilled; the PDF then falls back to the book's current title.
  billBookTitle String?

  // Internal only, never returned to customers: when an admin recorded that
  // the print-ready PDF was handed to the printer. Null means not sent.
  sentToPrinterAt DateTime?

  // Automatic data deletion (feature 6). pdfDeletedAt: the final PDF was deleted. paidAfterDeletionAt:
  // a payment arrived after this order's files were deleted, so no book can be made (admin follow-up).
  // Both are written by raw UPDATEs that leave updatedAt alone.
  pdfDeletedAt        DateTime?
  paidAfterDeletionAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhookEvents WebhookEvent[]

  couponRedemption CouponRedemption?

  addressChanges OrderAddressChange[]

  @@index([status, deliveredAt])
  @@map("orders")
}

// Running Bill of Supply serial, one row per Indian financial year (April to
// March), keyed by the year it starts in: 2026 = FY 2026-27. Advanced with a
// single atomic upsert inside the payment transaction, so concurrent payments
// can never share a number and a rolled-back payment never burns one.
model BillCounter {
  financialYear Int      @id
  lastSerial    Int
  updatedAt     DateTime @updatedAt

  @@map("bill_counters")
}

// ============================================================
// COUPONS
// ============================================================

enum CouponDiscountType {
  PERCENT // percentOff of the price, optionally capped by maxDiscount
  FIXED // amountOff, in the coupon's currency
}

enum CouponKind {
  PUBLIC // a shared code, e.g. a festive offer
  SINGLE_USE // generated by the admin for one person, usageLimit 1
}

enum CouponRedemptionStatus {
  RESERVED // an unpaid order holds the coupon; stops counting after the reservation window
  REDEEMED // the payment was captured
  RELEASED // the customer changed or removed the coupon before paying
}

// A discount code. The rules are typed columns (not JSON) so the database can
// validate them; see the CHECK constraints in the migration.
//
// Usage is NOT stored as a counter. The cap and the per-customer limit are
// enforced by locking this row inside the checkout transaction and counting
// CouponRedemption rows, so the rows are the single source of truth and nothing
// can drift. `updatedAt` doubles as the version checkout compares against.
model Coupon {
  id          String     @id @default(uuid())
  code        String     @unique // upper-case, 4 to 32 characters of A-Z, 0-9 and "-"
  name        String // admin-chosen label; shown to customers in the applied-coupon card and the offers list at checkout
  description String?    @db.Text
  kind        CouponKind @default(PUBLIC)

  discountType CouponDiscountType
  percentOff   Decimal?           @db.Decimal(5, 2) // PERCENT only, (0, 100]
  amountOff    Decimal?           @db.Decimal(10, 2) // FIXED only
  maxDiscount  Decimal?           @db.Decimal(10, 2) // optional cap for PERCENT
  // Required for FIXED and for a capped PERCENT (an amount only means something
  // in one currency). An uncapped PERCENT coupon has none and works everywhere.
  currency     String?

  // Validity, stored in UTC. The admin enters IST; a date-only end means the end
  // of that day in IST.
  startsAt DateTime?
  endsAt   DateTime?

  usageLimit       Int? // total uses across all customers; null = unlimited
  perCustomerLimit Int? // uses per customer; null = unlimited

  restrictedToUserId String? // only this customer may use it
  restrictedToUser   User?   @relation(fields: [restrictedToUserId], references: [id], onDelete: Restrict)

  allComics    Boolean       @default(true)
  comics       CouponComic[] // used when allComics is false
  countryCodes String[]      @default([]) // ISO alpha-2; empty = every country
  coverTypes   CoverType[]   @default([]) // empty = every cover type

  // Stored and shown in the admin now; enforced when a second kind of discount
  // exists (with one code box there is nothing to combine with).
  combinable Boolean @default(false)
  isActive   Boolean @default(true)

  // Shown to every customer on the checkout page when it fits their order. Only for public
  // codes; a coupon reserved for one customer is shown to that customer without this.
  showAtCheckout Boolean @default(false)

  // Only a customer who has no paid order yet may use it (see REVENUE_STATUSES in config/stats.ts).
  firstOrderOnly Boolean @default(false)

  createdById String // admin user ids, for audit; no foreign key on purpose
  updatedById String

  redemptions CouponRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, endsAt])
  @@map("coupons")
}

// The comics a coupon is limited to (when Coupon.allComics is false).
model CouponComic {
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  comicId  String
  comic    Comic  @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@id([couponId, comicId])
  @@index([comicId])
  @@map("coupon_comics")
}

// One row per order that used a coupon. Changing or removing the coupon on an
// unpaid order updates this row in place (status and coupon), so there is at
// most one row per order.
model CouponRedemption {
  id       String @id @default(uuid())
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  orderId  String @unique
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  status         CouponRedemptionStatus @default(RESERVED)
  discountAmount Decimal                @db.Decimal(10, 2) // snapshot, in the order's currency

  createdAt     DateTime  @default(now()) // reservation time; the reservation window counts from here
  redeemedAt    DateTime?
  releasedAt    DateTime?
  releaseReason String?

  @@index([couponId, status, createdAt])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

model SavedAddress {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label   String? // optional friendly name, e.g. "Home", "Office"
  name    String // recipient full name
  line1   String // address line 1
  line2   String? // address line 2 (optional)
  city    String
  state   String
  zip     String
  country String // ISO alpha-2, e.g. "IN", "US"
  phone   String

  isDefault Boolean @default(false) // only one per user can be true

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("saved_addresses")
}

// Idempotency tracking for Razorpay + Shiprocket webhooks

model WebhookEvent {
  id      String  @id @default(uuid())
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  source      String // "razorpay" | "shiprocket"
  eventId     String   @unique // the PROVIDER's own event id (x-razorpay-event-id) - unique per event, stable across that event's retries. Never the payment id: one payment emits several event types sharing it.
  eventType   String
  payloadJson Json
  processedAt DateTime @default(now())

  // Automatic data deletion (feature 6) looks for payment events by kind and time when it checks an order.
  @@index([source, eventType, processedAt])
  @@map("webhook_events")
}

// ============================================================
// SYSTEM CONFIG (tokens, feature flags, vendor settings)
// ============================================================

model SystemConfig {
  key       String   @id // e.g. "shiprocket_token", "shiprocket_token_expiry"
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("system_config")
}

model Country {
  id           String  @id @default(uuid())
  code         String  @unique // ISO 3166-1 alpha-2, e.g. "IN", "US"
  name         String // e.g. "India", "United States"
  currencyCode String // ISO 4217, e.g. "INR", "USD"
  flagUrl      String // R2 public bucket path to the flag image
  isActive     Boolean @default(true)

  pricingRules PricingRule[]
}

model AnnouncementBar {
  id        String  @id @default(uuid())
  message   String  @db.Text
  isActive  Boolean @default(false)
  sortOrder Int     @default(0) // controls rotation order on the frontend

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcement_bars")
}

model HeroImage {
  id        String   @id @default(uuid())
  imageUrl  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hero_images")
}

model CustomerReview {
  id           String   @id @default(uuid())
  customerName String
  description  String   @db.Text
  videoUrl     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("customer_reviews")
}

model TeamMember {
  id           String   @id @default(uuid())
  name         String
  role         String
  description  String?  @db.Text
  imageUrl     String?
  linkedinUrl  String?
  instagramUrl String?
  twitterUrl   String?
  isActive     Boolean  @default(true)

  // Website order on the Team page, ascending. Renumbered 0..N-1 by the admin's
  // reorder (hidden members keep a slot); a new member takes max + 1 (the end).
  sortOrder Int @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("team_members")
}

enum FeedbackStatus {
